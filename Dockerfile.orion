# Build: docker build -f Dockerfile.orion -t antigravity-orion:local .
# Runtime isolation is enforced by runtime/sandbox.py, including a non-root UID.
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash git \
    && rm -rf /var/lib/apt/lists/*
COPY antigravity_hybrid_orchestrator/runtime/requirements.lock /opt/runtime-requirements.lock
RUN python -m pip install --disable-pip-version-check --no-cache-dir --require-hashes -r /opt/runtime-requirements.lock
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    HOME=/tmp
USER 65534:65534
WORKDIR /workspace
CMD ["/bin/bash", "--noprofile", "--norc"]
